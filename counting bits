class Solution {
public:
    vector<int> countBits(int n) {
        int count;
        int x;
        vector<int> ans;
        int n1 = 0;

        while(n1 <= n){

            x = n1;
            count = 0;

            while(x > 0){
                int bit = x % 2;
                if(bit == 1){
                    count ++;
                }
                x /= 2;
            }

            ans.push_back(count);
            n1++;
            
        }
        return ans;
    }
};
