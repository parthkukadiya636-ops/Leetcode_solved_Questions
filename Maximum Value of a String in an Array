class Solution {
public:
    int maximumValue(vector<string>& strs) {

        int maxi = 0;

        for(int i = 0; i < strs.size(); i++) {

            bool isDigit = true;

            for(int j = 0; j < strs[i].size(); j++) {

                if(!isdigit(strs[i][j])) {
                    isDigit = false;
                    break;
                }
            }

            int value;

            if(isDigit) {
                value = stoi(strs[i]);
            }
            else {
                value = strs[i].size();
            }

            maxi = max(maxi, value);
        }

        return maxi;
    }
};
