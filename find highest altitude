class Solution {
public:
    int largestAltitude(vector<int>& gain) {
    
    int n = gain.size();

    vector<int> answer(n+1,0);
    int maxheight = 0;

    for(int i=1; i<=n; i++){
        answer[i] = gain[i-1] + answer[i-1];
        if(answer[i] > maxheight){
            maxheight = answer[i];
        }
    }
     return maxheight;   
    }
};
